# CIEL Studio : fichiers à ne jamais commiter

# Règle d'origine conservée (dossier du sous-module ajouté par erreur)
SITE-BTS-CIEL/

# Sauvegardes locales des étapes d'amélioration
sauvegardes/

# Configuration locale de Claude Code : tout est ignoré, sauf les Skills propres au projet.
# Les Skills tiers se réinstallent depuis skills-lock.json (npx skills experimental_install).
# security-review-ciel reste local tant que l'audit de sécurité n'est pas corrigé (dépôt public).
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/streamlit-apptest/
!.claude/skills/suivi-ameliorations/

# Copie de travail de la v36 (doublon de sauvegardes/app-v36-etape1.py)
app-v36.py

# Secrets : identifiants Supabase de Streamlit et variables d'environnement
.streamlit/secrets.toml
.env
.env.*

# Données locales créées par l'appli (comptes, progression, planning E6)
users_db_v2.json
e6_tasks_v7.json

# Python, environnements virtuels et fichiers temporaires
__pycache__/
*.py[cod]
.venv/
venv/
*.tmp
*.bak
*.log

# Fichiers système
.DS_Store
Thumbs.db
desktop.ini
